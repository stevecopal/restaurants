# ============================================================
# Restaurant management - Environment Variables Example
# ============================================================
# Copy this file to .env and replace every change-me value.
# Never commit .env or real credentials to Git.

# -----------------------------------------------------------
# Django Core
# -----------------------------------------------------------
SECRET_KEY=change-me-generate-a-unique-secret-key
DJANGO_DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_READ_DOT_ENV_FILE=True

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_ADMIN_URL=admin/
DJANGO_CSRF_TRUSTED_ORIGINS=https://*.example.com

DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=60
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True
DJANGO_SECURE_CONTENT_TYPE_NOSNIFF=True

# -----------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------
DB_NAME=restaurant
DB_USER=change-me
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

CONN_MAX_AGE=60

# -----------------------------------------------------------
# Redis Cache
# -----------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------
# Email
# -----------------------------------------------------------
# For local development, the console backend can be used instead:
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

EMAIL_HOST_USER=change-me
EMAIL_HOST_PASSWORD=change-me

DEFAULT_FROM_EMAIL=no-reply@example.com
SERVER_EMAIL=no-reply@example.com

# -----------------------------------------------------------
# Docker
# -----------------------------------------------------------

# Brevo - envoi en HTTPS (obligatoire sur Render, le SMTP y est bloque)
BREVO_API_KEY=change-me
